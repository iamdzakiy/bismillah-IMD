          <p className="text-white/60 text-xs sm:text-sm">Continue your microbial odyssey</p>
        </div>

        {verified && (
          <div className="mb-4 sm:mb-6 bg-green-500/10 border border-green-500/30 text-green-400 px-3 sm:px-4 py-2 sm:py-3 rounded-lg text-xs sm:text-sm text-center">
