    box-shadow: 0 0 30px rgba(168, 85, 247, 0.15), 0 0 60px rgba(168, 85, 247, 0.05);
  }

  .glow-fuchsia {
    box-shadow: 0 0 30px rgba(217, 70, 239, 0.15), 0 0 60px rgba(217, 70, 239, 0.05);
  }

  /* Particle Dot */
  .particle-dot {
    @apply absolute w-1 h-1 bg-purple-400/30 rounded-full;
  }
}

@layer utilities {
  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    @apply bg-[#0a0514];
  }
  ::-webkit-scrollbar-thumb {
    @apply bg-purple-900/50 rounded-full hover:bg-purple-500/50;
  }

  /* Smooth Animations */
  .animate-float {
    animation: float 8s ease-in-out infinite;
  }
  
  .animate-blob {
    animation: blob 35s infinite;
  }

  .animate-pulse-glow {
    animation: pulseGlow 4s ease-in-out infinite;
  }

  .animate-drift {
    animation: drift 25s ease-in-out infinite;
  }

  .animate-spin-slow {
    animation: spin 20s linear infinite;
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
  }

  .animate-slide-up {
    animation: slideUp 0.6s ease-out forwards;
  }

  .animate-scale-in {
    animation: scaleIn 0.5s ease-out forwards;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }

  @keyframes blob {
