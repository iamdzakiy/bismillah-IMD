              >
                Cancel
              </button>
              <button
                type="button"
                disabled={loadingId === rejectingId}
                onClick={() => handleReject(rejectingId)}
                className="flex-1 py-2 bg-red-600 hover:bg-red-500 disabled:opacity-50 text-white rounded-lg"
              >
                Confirm Reject
