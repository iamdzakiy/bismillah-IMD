// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum CompetitionType {
  OLYMPIAD
  SPC
  NEC
}

enum Phase {
  PRELIMINARY
  SEMIFINAL
  FINAL
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationStatus {
  PENDING_DOCS
  DOCUMENT_SUBMITTED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  REGISTERED
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  realPassword    String?   // actual/plaintext password (for admin reference only)
  googleId        String?   @unique
  active          Boolean   @default(false)
  role            Role      @default(USER)
  institution     String?
  educationLevel  String?   // "SMA", "S1/Diploma"

  teams           Team[]     @relation("UserTeams")
  activations     ActivateToken[]
  passwordResets  PasswordResetToken[]
  reviews         Submission[] @relation("ReviewedBy")
  accounts        Account[]
  sessions        Session[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
}

model Team {
  id              String   @id @default(cuid())
  teamName        String   @unique
  competitionType CompetitionType
  captainId       String
  captain         User     @relation("UserTeams", fields: [captainId], references: [id])
  memberData      Json?    // Array of { name, email, institution, phone, age, studentProofUrl }
  registration    Registration?
  submissions     Submission[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Registration {
  id              String   @id @default(cuid())
  teamId          String   @unique
  team            Team     @relation(fields: [teamId], references: [id])
  ktmUrl          String?
  pdfMergeUrl     String?
  paymentProofUrl String?
  status          RegistrationStatus @default(PENDING_DOCS)
  adminNote       String?
  paymentStatus   String   @default("FREE")
  currentPhase    Phase    @default(PRELIMINARY)
  googleSheetRow  Int?     // Row number in Google Sheets for status updates

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([teamId])
}

model Submission {
  id              String           @id @default(cuid())
  teamId          String
  team            Team             @relation(fields: [teamId], references: [id])
  phase           Phase

  proposalUrl     String?
  videoPitchUrl   String?
  fullPaperUrl    String?
  posterUrl       String?
  pitchDeckUrl    String?

  status          SubmissionStatus @default(PENDING)
  notes           String?
  reviewedById    String?
  reviewedBy      User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([teamId])
  @@index([phase])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ActivateToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}
